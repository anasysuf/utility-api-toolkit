{
  "name": "utility-api-toolkit",
  "version": "1.0.0",
  "description": "Modular open-source REST API toolkit for image compression, QR code generation, and slug conversion",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\""
  },
  "keywords": [
    "utility",
    "api",
    "toolkit",
    "image-compression",
    "qr-code",
    "slug",
    "fastify",
    "typescript",
    "zod"
  ],
  "author": "Anas Yusuf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anasysuf/utility-api-toolkit.git"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.7"
  }
}
